@dataclass
class VLReconstruction:
    """Reconstructed VL verse with metadata."""
    book: str
    chapter: int
    verse: int
    latin_text: str
    source_tier: str  # VL-EXTANT | SPINE-RECON | HYBRID
    confidence: float
    apparatus: str = ''
    voltage_trace: str = ''
    warnings: List[str] = field(default_factory=list)
    critical_passage: bool = False

class SourceTier(Enum):
    """Reconstruction confidence tiers."""
    VL_EXTANT = "VL-EXTANT"
    VL_CRITICAL = "VL-CRITICAL"
    SPINE_RECON = "SPINE-RECON"
    HYBRID = "HYBRID"
    GAP = "GAP"

# ============================================================================
# COVENANT ANCHOR ENGINE
# ============================================================================

class CovenantAnchorVL:
    """Main reconstruction engine."""
    
    def __init__(self):
        self.config = CONFIG
        self.locks = self.config['immutable_locks']
        self.critical = self.config['critical_passages']
        self.rules = self.config['processing_rules']
        self.spine = SPINE
        self.fragments = VL_FRAGMENTS
    
    def reconstruct_verse(self, book: str, chapter: int, verse: int) -> VLReconstruction:
        """
        Reconstruct a single verse.
        
        Priority:
        1. Extant VL fragment (highest confidence)
        2. Spine-based retroversion from Greek
        3. Gap marker if no sources
        """
        ref = f"{book}.{chapter}.{verse}"
        
        # Check for extant VL fragment
        if ref in self.fragments:
            frag = self.fragments[ref]
            apparatus, voltage, warnings = self._apply_tri_locks(
                frag['text'], ref
            )
            
            is_critical = frag.get('critical', False)
            
            return VLReconstruction(
                book=book,
                chapter=chapter,
                verse=verse,
                latin_text=frag['text'],
                source_tier=SourceTier.VL_CRITICAL.value if is_critical else SourceTier.VL_EXTANT.value,
                confidence=frag['confidence'],
                apparatus=apparatus,
                voltage_trace=voltage,
                warnings=warnings,
                critical_passage=is_critical
            )
        
        # No extant fragment - would need Greek source
        # (In production, fetch from LXX/NT API here)
        return VLReconstruction(
            book=book,
            chapter=chapter,
            verse=verse,
            latin_text="[RECONSTRUCTION PENDING - NEEDS GREEK SOURCE]",
            source_tier=SourceTier.GAP.value,
            confidence=0.0,
            apparatus="No extant VL fragment or Greek source available"
        )
    
    def _apply_tri_locks(self, latin_text: str, ref: str) -> Tuple[str, str, List[str]]:
        """Apply semantic locks and generate apparatus."""
        apparatus_parts = []
        voltage_parts = []
        warnings = []
        
        text_lower = latin_text.lower()
        
        for key, lock in self.locks.items():
            if lock['latin'].lower() in text_lower:
                apparatus_parts.append(f"{lock['latin']} = {lock['gloss']}")
                voltage_parts.append(
                    f"{lock['hebrew']}/{lock['greek']}/{lock['latin']}"
                )
        
        # Check Trinity guard (Rule_12)
        subordinate_terms = ['creatus', 'minor', 'temporalis', 'factus']
        divine_terms = ['filius', 'spiritus', 'verbum']
        
        if any(sub in text_lower for sub in subordinate_terms):
            if any(div in text_lower for div in divine_terms):
                warnings.append(
                    "⚠ Rule_12 TRINITY_GUARD: Check for subordinationist language"
                )
        
        apparatus = ' | '.join(apparatus_parts)
        voltage = ' → '.join(voltage_parts)
        
        return apparatus, voltage, warnings
    
    def export_text(self, reconstructions: List[VLReconstruction], 
                    include_apparatus: bool = True) -> str:
        """Export as readable text."""
        lines = [
            "VETUS LATINA - COVENANT ANCHOR EDITION",
            f"Engine Version: {self.config['version']}",
            "=" * 80,
            ""
        ]
        
        current_book = None
        current_chapter = None
        
        for rec in reconstructions:
            # Book header
            if rec.book != current_book:
                lines.append(f"\n{'=' * 80}")
                lines.append(f"{rec.book.upper()}")
                lines.append('=' * 80)
                current_book = rec.book
                current_chapter = None
            
            # Chapter header
            if rec.chapter != current_chapter:
                lines.append(f"\nCaput {rec.chapter}")
                lines.append('-' * 40)
                current_chapter = rec.chapter
            
            # Critical passage marker
            if rec.critical_passage:
                lines.append("\n⚡ CRITICAL VOLTAGE PASSAGE ⚡")
            
            # Verse text
            lines.append(f"{rec.verse}. {rec.latin_text}")
            
            # Apparatus
            if include_apparatus:
                lines.append(f"   [{rec.source_tier} | {rec.confidence:.0%}]")
                if rec.apparatus:
                    lines.append(f"   Tri-Lock: {rec.apparatus}")
                if rec.warnings:
                    for warning in rec.warnings:
                        lines.append(f"   {warning}")
            
            lines.append("")
        
        return '\n'.join(lines)
    
    def export_usfm(self, reconstructions: List[VLReconstruction]) -> str:
        """Export as USFM for Bible software."""
        if not reconstructions:
            return ""
        
        book = reconstructions[0].book
        book_code = book[:3].upper()
        
        lines = [
            f"\\id {book_code} Vetus Latina - Covenant Anchor Edition",
            f"\\h {book}",
            f"\\mt {book.upper()}"
        ]
        
        current_chapter = None
        
        for rec in reconstructions:
            if rec.chapter != current_chapter:
                lines.append(f"\\c {rec.chapter}")
                current_chapter = rec.chapter
            
            lines.append(f"\\v {rec.verse} {rec.latin_text}")
            
            # Footnotes for apparatus
            if rec.apparatus or rec.warnings:
                footnote_parts = [rec.source_tier, f"{rec.confidence:.0%}"]
                if rec.apparatus:
                    footnote_parts.append(rec.apparatus)
                if rec.warnings:
                    footnote_parts.extend(rec.warnings)
                
                footnote = ' | '.join(footnote_parts)
                lines.append(f"\\f + \\ft {footnote}\\f*")
        
        return '\n'.join(lines)

